<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Основной контент -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:fitsSystemWindows="true">

        <!-- ActionBar -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
            app:title="Менеджер паролей"
            android:layout_marginBottom="16dp" />

        <!-- Карточка с генератором -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="16dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="8dp"
            app:cardBackgroundColor="?attr/colorSurface"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Генератор паролей"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="16dp" />

                <!-- Поле отображения пароля и кнопка рядом -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/generatedPasswordText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Сгенерированный пароль"
                        android:padding="12dp"
                        android:layout_marginEnd="8dp"
                        android:textColor="?attr/colorOnSurface"
                        android:elevation="1dp"
                        android:textIsSelectable="true"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/colorSurfaceContainer" />

                    <EditText
                        android:id="@+id/editablePasswordText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Редактируемый пароль"
                        android:padding="12dp"
                        android:layout_marginEnd="8dp"
                        android:textColor="?attr/colorOnSurface"
                        android:elevation="1dp"
                        android:inputType="textVisiblePassword"
                        android:background="?attr/colorSurfaceContainer"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/editPasswordButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="✎"
                        android:textSize="18sp"
                        android:textColor="@android:color/white"
                        app:cornerRadius="4dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:padding="0dp"
                        android:gravity="center"
                        android:contentDescription="Редактировать"
                        android:layout_gravity="center_vertical"
                        android:enabled="false"
                        style="@style/Widget.Material3.Button" />

                </LinearLayout>

                <CheckBox
                    android:id="@+id/useLettersCheckBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Использовать большие и малые буквы"
                    android:layout_marginBottom="8dp" />

                <CheckBox
                    android:id="@+id/useDigitsCheckBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Использовать цифры"
                    android:layout_marginBottom="8dp" />

                <CheckBox
                    android:id="@+id/useSpecialCheckBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Использовать спецсимволы"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/passwordLengthHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Количество символов в пароле"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/passwordLengthEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Длина пароля"
                    android:inputType="number"
                    android:text="8"
                    android:importantForAutofill="no"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/generateButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Генерировать"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/copyButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Скопировать в буфер"
                    android:enabled="false"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/saveButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Сохранить пароль"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/masterPasswordStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Мастер-пароль не задан. Сохранение недоступно!"
                    android:textColor="?attr/colorError"
                    android:gravity="center"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/versionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ver. 0.0"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

    </LinearLayout>

    <!-- Шторка (Drawer) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>